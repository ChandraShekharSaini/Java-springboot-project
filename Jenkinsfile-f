pipeline {

    agent any

    environment {

        // ============================================================
        // AWS
        // ============================================================

        AWS_REGION = 'us-east-1'

        // ============================================================
        // GitHub
        // ============================================================

        PROJECT_REPO = 'https://github.com/ChandraShekharSaini/Java-springboot-project.git'

        // ============================================================
        // Terraform
        // ============================================================

        TERRAFORM_DIR = 'terraform'

        // ============================================================
        // Backend
        // ============================================================

        IMAGE_NAME = 'springboot-app'

        // ============================================================
        // Frontend
        // ============================================================

        FRONTEND_IMAGE_NAME = 'streamlit-app'

        // ============================================================
        // Docker image tag
        // Jenkins build number
        // ============================================================

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // 1. Checkout Project
        // ============================================================

        stage('Checkout Project') {

            steps {

                git branch: 'main',
                    url: "${PROJECT_REPO}"

            }
        }


        // ============================================================
        // 2. Terraform Init
        // ============================================================

        stage('Terraform Init') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        terraform init
                    '''
                }
            }
        }


        // ============================================================
        // 3. Terraform Plan
        // ============================================================

        stage('Terraform Plan') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        terraform plan -out=tfplan
                    '''
                }
            }
        }


        // ============================================================
        // 4. Terraform Apply
        // ============================================================

        stage('Terraform Apply') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        terraform apply -auto-approve tfplan
                    '''
                }
            }
        }


        // ============================================================
        // 5. Get Terraform Outputs
        // ============================================================

        stage('Get AWS Resource IDs') {

    steps {

        dir("${TERRAFORM_DIR}") {

            script {

                // Backend Private EC2 ID
                env.BACKEND_EC2_ID = sh(
                    script: 'terraform output -raw private_backend_instance_id',
                    returnStdout: true
                ).trim()

                // Frontend Private EC2 ID
                env.FRONTEND_EC2_ID = sh(
                    script: 'terraform output -raw private_frontend_instance_id',
                    returnStdout: true
                ).trim()

                // Backend Private IP
                env.BACKEND_PRIVATE_IP = sh(
                    script: 'terraform output -raw private_backend_instance_ip',
                    returnStdout: true
                ).trim()

                // Frontend Private IP
                env.FRONTEND_PRIVATE_IP = sh(
                    script: 'terraform output -raw private_frontend_instance_ip',
                    returnStdout: true
                ).trim()

                // ECR Repository
                env.ECR_REPOSITORY = sh(
                    script: 'terraform output -raw ecr_repository_url',
                    returnStdout: true
                ).trim()

                echo "=========================================="
                echo "AWS RESOURCES"
                echo "=========================================="
                echo "Backend EC2 ID     : ${env.BACKEND_EC2_ID}"
                echo "Backend Private IP : ${env.BACKEND_PRIVATE_IP}"
                echo "Frontend EC2 ID    : ${env.FRONTEND_EC2_ID}"
                echo "Frontend Private IP: ${env.FRONTEND_PRIVATE_IP}"
                echo "ECR                : ${env.ECR_REPOSITORY}"
                echo "=========================================="
            }
        }
    }
}


        // ============================================================
        // 6. Maven Build - Backend
        // ============================================================

        stage('Maven Build') {

            steps {

                dir('backend') {

                    sh '''
                        mvn clean package -DskipTests
                    '''
                }
            }
        }


        // ============================================================
        // 7. Backend Docker Build
        // ============================================================

        stage('Backend Docker Build') {

            steps {

                dir('backend') {

                    sh '''
                        docker build \
                            -t ${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME}:latest .
                    '''
                }
            }
        }


        // ============================================================
        // 8. Frontend Docker Build
        // ============================================================

        stage('Frontend Docker Build') {

            steps {

                dir('frontend') {

                    sh '''
                        docker build \
                            -t ${FRONTEND_IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${FRONTEND_IMAGE_NAME}:latest .
                    '''
                }
            }
        }


        // ============================================================
        // 9. Login to ECR
        // ============================================================

        stage('Login to ECR') {

            steps {

                sh '''
                    aws ecr get-login-password \
                        --region ${AWS_REGION} |
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REPOSITORY}
                '''
            }
        }


        // ============================================================
        // 10. Push Backend Docker Image
        // ============================================================

        stage('Push Backend Docker Image') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "PUSHING BACKEND IMAGE"
                    echo "=========================================="

                    docker tag \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        ${ECR_REPOSITORY}:${IMAGE_TAG}

                    docker tag \
                        ${IMAGE_NAME}:latest \
                        ${ECR_REPOSITORY}:latest


                    docker push \
                        ${ECR_REPOSITORY}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REPOSITORY}:latest
                '''
            }
        }


        // ============================================================
        // 11. Push Frontend Docker Image
        // ============================================================

        stage('Push Frontend Docker Image') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "PUSHING FRONTEND IMAGE"
                    echo "=========================================="

                    docker tag \
                        ${FRONTEND_IMAGE_NAME}:${IMAGE_TAG} \
                        ${ECR_REPOSITORY}:frontend-${IMAGE_TAG}

                    docker tag \
                        ${FRONTEND_IMAGE_NAME}:latest \
                        ${ECR_REPOSITORY}:frontend-latest


                    docker push \
                        ${ECR_REPOSITORY}:frontend-${IMAGE_TAG}

                    docker push \
                        ${ECR_REPOSITORY}:frontend-latest
                '''
            }
        }


        // ============================================================
        // 12. Deploy Backend to Private EC2
        // ============================================================

        stage('Deploy Backend to Private EC2') {

    steps {

        script {

            echo "=========================================="
            echo "DEPLOYING BACKEND"
            echo "=========================================="

            echo "Backend EC2: ${BACKEND_EC2_ID}"
            echo "ECR: ${ECR_REPOSITORY}"
            echo "Image: ${IMAGE_TAG}"


            def backendCommandId = sh(
                script: """
                    aws ssm send-command \
                        --region ${AWS_REGION} \
                        --instance-ids ${BACKEND_EC2_ID} \
                        --document-name AWS-RunShellScript \
                        --parameters 'commands=[
                            "set -e",
                            "echo Backend deployment started",
                            "docker --version",
                            "systemctl is-active docker",
                            "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPOSITORY}",
                            "docker pull ${ECR_REPOSITORY}:${IMAGE_TAG}",
                            "docker stop ${IMAGE_NAME} || true",
                            "docker rm ${IMAGE_NAME} || true",
                            "docker run -d --restart unless-stopped --name ${IMAGE_NAME} -p 8080:8084 ${ECR_REPOSITORY}:${IMAGE_TAG}",
                            "sleep 5",
                            "docker ps",
                            "echo Backend deployment completed"
                        ]' \
                        --query 'Command.CommandId' \
                        --output text
                """,
                returnStdout: true
            ).trim()


            echo "Backend SSM Command ID: ${backendCommandId}"


            // ========================================================
            // Wait for SSM command
            // ========================================================

            sh """
                aws ssm wait command-executed \
                    --region ${AWS_REGION} \
                    --command-id ${backendCommandId} \
                    --instance-id ${BACKEND_EC2_ID}
            """


            // ========================================================
            // Show SSM result
            // ========================================================

            sh """
                aws ssm get-command-invocation \
                    --region ${AWS_REGION} \
                    --command-id ${backendCommandId} \
                    --instance-id ${BACKEND_EC2_ID}
            """


            // ========================================================
            // Get deployment status
            // ========================================================

            def backendStatus = sh(
                script: """
                    aws ssm get-command-invocation \
                        --region ${AWS_REGION} \
                        --command-id ${backendCommandId} \
                        --instance-id ${BACKEND_EC2_ID} \
                        --query 'Status' \
                        --output text
                """,
                returnStdout: true
            ).trim()


            echo "Backend Deployment Status: ${backendStatus}"


            if (backendStatus != 'Success') {

                error(
                    "Backend deployment failed. SSM status: ${backendStatus}"
                )
            }


            echo "=========================================="
            echo "BACKEND DEPLOYMENT SUCCESSFUL"
            echo "=========================================="
        }
    }
}

        // ============================================================
        // 13. Deploy Frontend to Private EC2
        // ============================================================

       stage('Deploy Frontend to Private EC2') {

    steps {

        script {

            echo "=========================================="
            echo "DEPLOYING FRONTEND"
            echo "=========================================="

            echo "Frontend EC2: ${FRONTEND_EC2_ID}"
            echo "ECR: ${ECR_REPOSITORY}"
            echo "Image: frontend-${IMAGE_TAG}"


            def frontendCommandId = sh(
                script: """
                    aws ssm send-command \
                        --region ${AWS_REGION} \
                        --instance-ids ${FRONTEND_EC2_ID} \
                        --document-name AWS-RunShellScript \
                        --parameters 'commands=[
                            "set -e",
                            "echo Frontend deployment started",
                            "docker --version",
                            "systemctl is-active docker",
                            "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPOSITORY}",
                            "docker pull ${ECR_REPOSITORY}:frontend-${IMAGE_TAG}",
                            "docker stop ${FRONTEND_IMAGE_NAME} || true",
                            "docker rm ${FRONTEND_IMAGE_NAME} || true",
                            "docker run -d --restart unless-stopped --name ${FRONTEND_IMAGE_NAME} -p 8501:8501 -e API_URL=http://${BACKEND_PRIVATE_IP}:8080 ${ECR_REPOSITORY}:frontend-${IMAGE_TAG}",
                            "sleep 5",
                            "docker ps",
                            "echo Frontend deployment completed"
                        ]' \
                        --query 'Command.CommandId' \
                        --output text
                """,
                returnStdout: true
            ).trim()


            echo "Frontend SSM Command ID: ${frontendCommandId}"


            // ========================================================
            // Wait for SSM command
            // ========================================================

            sh """
                aws ssm wait command-executed \
                    --region ${AWS_REGION} \
                    --command-id ${frontendCommandId} \
                    --instance-id ${FRONTEND_EC2_ID}
            """


            // ========================================================
            // Show command result
            // ========================================================

            sh """
                aws ssm get-command-invocation \
                    --region ${AWS_REGION} \
                    --command-id ${frontendCommandId} \
                    --instance-id ${FRONTEND_EC2_ID}
            """


            // ========================================================
            // Get deployment status
            // ========================================================

            def frontendStatus = sh(
                script: """
                    aws ssm get-command-invocation \
                        --region ${AWS_REGION} \
                        --command-id ${frontendCommandId} \
                        --instance-id ${FRONTEND_EC2_ID} \
                        --query 'Status' \
                        --output text
                """,
                returnStdout: true
            ).trim()


            echo "Frontend Deployment Status: ${frontendStatus}"


            if (frontendStatus != 'Success') {

                error(
                    "Frontend deployment failed. SSM status: ${frontendStatus}"
                )
            }


            echo "=========================================="
            echo "FRONTEND DEPLOYMENT SUCCESSFUL"
            echo "=========================================="
        }
    }
}


        // ============================================================
        // 14. Verify Backend Container
        // ============================================================

        stage('Verify Backend') {

            steps {

                script {

                    echo "=========================================="
                    echo "VERIFYING BACKEND"
                    echo "=========================================="


                    def verifyCommandId = sh(

                        script: """

                            aws ssm send-command \\

                                --region ${AWS_REGION} \\

                                --instance-ids ${BACKEND_EC2_ID} \\

                                --document-name "AWS-RunShellScript" \\

                                --parameters 'commands=[

                                    "docker ps",

                                    "curl -f http://localhost:8080/student/all"

                                ]' \\

                                --query "Command.CommandId" \\

                                --output text

                        """,

                        returnStdout: true

                    ).trim()


                    sh """

                        aws ssm wait command-executed \\

                            --region ${AWS_REGION} \\

                            --command-id ${verifyCommandId} \\

                            --instance-id ${BACKEND_EC2_ID}

                    """


                    sh """

                        aws ssm get-command-invocation \\

                            --region ${AWS_REGION} \\

                            --command-id ${verifyCommandId} \\

                            --instance-id ${BACKEND_EC2_ID}

                    """
                }
            }
        }


        // ============================================================
        // 15. Verify Frontend Container
        // ============================================================

        stage('Verify Frontend') {

            steps {

                script {

                    echo "=========================================="
                    echo "VERIFYING FRONTEND"
                    echo "=========================================="


                    def verifyCommandId = sh(

                        script: """

                            aws ssm send-command \\

                                --region ${AWS_REGION} \\

                                --instance-ids ${FRONTEND_EC2_ID} \\

                                --document-name "AWS-RunShellScript" \\

                                --parameters 'commands=[

                                    "docker ps",

                                    "curl -f http://localhost:8501"

                                ]' \\

                                --query "Command.CommandId" \\

                                --output text

                        """,

                        returnStdout: true

                    ).trim()


                    sh """

                        aws ssm wait command-executed \\

                            --region ${AWS_REGION} \\

                            --command-id ${verifyCommandId} \\

                            --instance-id ${FRONTEND_EC2_ID}

                    """


                    sh """

                        aws ssm get-command-invocation \\

                            --region ${AWS_REGION} \\

                            --command-id ${verifyCommandId} \\

                            --instance-id ${FRONTEND_EC2_ID}

                    """
                }
            }
        }


        
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo """
            ==================================================
                    DEPLOYMENT SUCCESSFUL
            ==================================================

            Backend EC2:
            ${env.BACKEND_EC2_ID}

            Frontend EC2:
            ${env.FRONTEND_EC2_ID}

            ECR:
            ${env.ECR_REPOSITORY}

            Backend Image:
            ${env.ECR_REPOSITORY}:${env.IMAGE_TAG}

            Frontend Image:
            ${env.ECR_REPOSITORY}:frontend-${env.IMAGE_TAG}

            Region:
            ${env.AWS_REGION}

            ==================================================
            """
        }


        failure {

            echo """
            ==================================================
                    CI/CD PIPELINE FAILED
            ==================================================
            """
        }
    }
}