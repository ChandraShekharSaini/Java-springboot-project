pipeline {

    agent any

    environment {

        // ============================================================
        // AWS
        // ============================================================

        AWS_REGION = 'us-east-1'

        // ============================================================
        // GitHub
        // ============================================================

        PROJECT_REPO = 'https://github.com/ChandraShekharSaini/Java-springboot-project.git'

        // ============================================================
        // Terraform
        // ============================================================

        TERRAFORM_DIR = 'terraform'

        // ============================================================
        // Backend
        // ============================================================

        IMAGE_NAME = 'springboot-app'

        // ============================================================
        // Frontend
        // ============================================================

        FRONTEND_IMAGE_NAME = 'streamlit-app'

        // ============================================================
        // Docker image tag
        // Jenkins build number
        // ============================================================

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // 1. Checkout Project
        // ============================================================

        stage('Checkout Project') {

            steps {

                git branch: 'main',
                    url: "${PROJECT_REPO}"

            }
        }


        // ============================================================
        // 2. Terraform Init
        // ============================================================

        stage('Terraform Init') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        terraform init
                    '''
                }
            }
        }


        // ============================================================
        // 3. Terraform Plan
        // ============================================================

        stage('Terraform Plan') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        terraform plan -out=tfplan
                    '''
                }
            }
        }


        // ============================================================
        // 4. Terraform Apply
        // ============================================================

        stage('Terraform Apply') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        terraform apply -auto-approve tfplan
                    '''
                }
            }
        }


        // ============================================================
        // 5. Get Terraform Outputs
        // ============================================================

        stage('Get AWS Resource IDs') {

    steps {

        dir("${TERRAFORM_DIR}") {

            script {

                // Backend Private EC2 ID
                env.BACKEND_EC2_ID = sh(
                    script: 'terraform output -raw private_backend_instance_id',
                    returnStdout: true
                ).trim()

                // Frontend Private EC2 ID
                env.FRONTEND_EC2_ID = sh(
                    script: 'terraform output -raw private_frontend_instance_id',
                    returnStdout: true
                ).trim()

                // Backend Private IP
                env.BACKEND_PRIVATE_IP = sh(
                    script: 'terraform output -raw private_backend_instance_ip',
                    returnStdout: true
                ).trim()

                // Frontend Private IP
                env.FRONTEND_PRIVATE_IP = sh(
                    script: 'terraform output -raw private_frontend_instance_ip',
                    returnStdout: true
                ).trim()

                // ECR Repository
                env.ECR_REPOSITORY = sh(
                    script: 'terraform output -raw ecr_repository_url',
                    returnStdout: true
                ).trim()

                echo "=========================================="
                echo "AWS RESOURCES"
                echo "=========================================="
                echo "Backend EC2 ID     : ${env.BACKEND_EC2_ID}"
                echo "Backend Private IP : ${env.BACKEND_PRIVATE_IP}"
                echo "Frontend EC2 ID    : ${env.FRONTEND_EC2_ID}"
                echo "Frontend Private IP: ${env.FRONTEND_PRIVATE_IP}"
                echo "ECR                : ${env.ECR_REPOSITORY}"
                echo "=========================================="
            }
        }
    }
}


        // ============================================================
        // 6. Maven Build - Backend
        // ============================================================

        stage('Maven Build') {

            steps {

                dir('backend') {

                    sh '''
                        mvn clean package -DskipTests
                    '''
                }
            }
        }


        stage('SonarQube Analysis') {
    steps {
        dir('backend') {
            withSonarQubeEnv('SonarQube') {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        mvn clean verify \
                          org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=Java \
                          -Dsonar.projectName=Java \
                          -Dsonar.host.url=$SONAR_HOST_URL \
                          -Dsonar.token=$SONAR_TOKEN
                    '''
                }
            }
        }
    }
}



        // ============================================================
        // 7. Backend Docker Build
        // ============================================================

        stage('Backend Docker Build') {

            steps {

                dir('backend') {

                    sh '''
                        docker build \
                            -t ${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME}:latest .
                    '''
                }
            }
        }


        // ============================================================
        // 8. Frontend Docker Build
        // ============================================================

        stage('Frontend Docker Build') {

            steps {

                dir('frontend') {

                    sh '''
                        docker build \
                            -t ${FRONTEND_IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${FRONTEND_IMAGE_NAME}:latest .
                    '''
                }
            }
        }


        // ============================================================
        // 9. Login to ECR
        // ============================================================

        stage('Login to ECR') {

            steps {

                sh '''
                    aws ecr get-login-password \
                        --region ${AWS_REGION} |
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REPOSITORY}
                '''
            }
        }


        // ============================================================
        // 10. Push Backend Docker Image
        // ============================================================

        stage('Push Backend Docker Image') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "PUSHING BACKEND IMAGE"
                    echo "=========================================="

                    docker tag \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        ${ECR_REPOSITORY}:${IMAGE_TAG}

                    docker tag \
                        ${IMAGE_NAME}:latest \
                        ${ECR_REPOSITORY}:latest


                    docker push \
                        ${ECR_REPOSITORY}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REPOSITORY}:latest
                '''
            }
        }


        // ============================================================
        // 11. Push Frontend Docker Image
        // ============================================================

        stage('Push Frontend Docker Image') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "PUSHING FRONTEND IMAGE"
                    echo "=========================================="

                    docker tag \
                        ${FRONTEND_IMAGE_NAME}:${IMAGE_TAG} \
                        ${ECR_REPOSITORY}:frontend-${IMAGE_TAG}

                    docker tag \
                        ${FRONTEND_IMAGE_NAME}:latest \
                        ${ECR_REPOSITORY}:frontend-latest


                    docker push \
                        ${ECR_REPOSITORY}:frontend-${IMAGE_TAG}

                    docker push \
                        ${ECR_REPOSITORY}:frontend-latest
                '''
            }
        }


        // ============================================================
        // 12. Deploy Backend to Private EC2
        // ============================================================


        stage('Deploy Backend to Private EC2') {


steps {

    script {

        echo "=========================================="
        echo "DEPLOYING BACKEND"
        echo "=========================================="

        echo "Backend EC2: ${BACKEND_EC2_ID}"
        echo "ECR: ${ECR_REPOSITORY}"
        echo "Image: ${IMAGE_TAG}"


        // ========================================================
        // Send deployment command to Private EC2
        // ========================================================

        def backendCommandId = sh(
            script: """
                aws ssm send-command \\
                    --region ${AWS_REGION} \\
                    --instance-ids ${BACKEND_EC2_ID} \\
                    --document-name AWS-RunShellScript \\
                    --parameters 'commands=[
                        "set -e",

                        "echo ===== BACKEND DEPLOYMENT STARTED =====",

                        "echo Checking Docker...",
                        "docker --version",
                        "systemctl is-active docker",

                        "echo ===== CHECKING AWS CLI =====",
                        "aws --version",

                        "echo ===== ECR LOGIN =====",
                        "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPOSITORY}",

                        "echo ===== ECR LOGIN SUCCESS =====",

                        "echo ===== PULLING IMAGE =====",
                        "docker pull ${ECR_REPOSITORY}:${IMAGE_TAG}",

                        "echo ===== IMAGE PULL SUCCESS =====",

                        "echo ===== CHECKING IMAGE =====",
                        "docker images",

                        "echo ===== STOPPING OLD CONTAINER =====",
                        "docker stop ${IMAGE_NAME} || true",

                        "echo ===== REMOVING OLD CONTAINER =====",
                        "docker rm ${IMAGE_NAME} || true",

                        "echo ===== STARTING NEW CONTAINER =====",
                        "docker run -d --restart unless-stopped --name ${IMAGE_NAME} -p 8084:8084 ${ECR_REPOSITORY}:${IMAGE_TAG}",

                        "echo ===== WAITING FOR CONTAINER =====",
                        "sleep 10",

                        "echo ===== CONTAINER STATUS =====",
                        "docker ps -a",

                        "echo ===== BACKEND DEPLOYMENT COMPLETED ====="
                    ]' \\
                    --query 'Command.CommandId' \\
                    --output text
            """,
            returnStdout: true
        ).trim()


        echo "Backend SSM Command ID: ${backendCommandId}"


        // ========================================================
        // Wait for SSM command
        // Do NOT fail Jenkins immediately
        // ========================================================

        def waitStatus = sh(
            script: """
                aws ssm wait command-executed \\
                    --region ${AWS_REGION} \\
                    --command-id ${backendCommandId} \\
                    --instance-id ${BACKEND_EC2_ID}
            """,
            returnStatus: true
        )

        echo "SSM Wait Exit Code: ${waitStatus}"


        // ========================================================
        // Get complete SSM result
        // ========================================================

        sh """
            echo "=========================================="
            echo "SSM COMMAND OUTPUT"
            echo "=========================================="

            aws ssm get-command-invocation \\
                --region ${AWS_REGION} \\
                --command-id ${backendCommandId} \\
                --instance-id ${BACKEND_EC2_ID} \\
                --query '{Status:Status,StatusDetails:StatusDetails,ResponseCode:ResponseCode,Output:StandardOutputContent,Error:StandardErrorContent}' \\
                --output json
        """


        // ========================================================
        // Get deployment status
        // ========================================================

        def backendStatus = sh(
            script: """
                aws ssm get-command-invocation \\
                    --region ${AWS_REGION} \\
                    --command-id ${backendCommandId} \\
                    --instance-id ${BACKEND_EC2_ID} \\
                    --query 'Status' \\
                    --output text
            """,
            returnStdout: true
        ).trim()


        echo "Backend Deployment Status: ${backendStatus}"


        // ========================================================
        // Fail Jenkins if deployment failed
        // ========================================================

        if (backendStatus != 'Success') {

            error(
                "Backend deployment failed. SSM status: ${backendStatus}"
            )
        }


        echo "=========================================="
        echo "BACKEND DEPLOYMENT SUCCESSFUL"
        echo "=========================================="
    }
}


}


